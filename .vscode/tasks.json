{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare build directory",
      "type": "process",
      "command": "cmake",
      "args": ["-E", "make_directory", "${workspaceFolder}/build"],
      "problemMatcher": []
    },
    {
      "label": "Build active problem",
      "type": "cppbuild",
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++20",
        "-O2",
        "-pipe",
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/build/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Prepare build directory",
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}